{
  "family": "node-app-tasks",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::224084343375:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "node-web-tasks",
      "image": "224084343375.dkr.ecr.us-east-2.amazonaws.com/nodeapp:v1",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
